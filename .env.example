# Copy to .env before `docker compose up --build`.

# ── required ─────────────────────────────────────────────────────────────────
# The operator bearer. Generate one: openssl rand -hex 24
# Every write is gated on it. There is no default: a Lab that starts without a
# token would be an open write surface on whatever port you published.
AXOR_LAB_CONTROL_TOKEN=

# Postgres password. The stack runs its own database; documents live there as
# jsonb rows, which is what makes them durable across restarts AND searchable
# inside (a directory of JSON files is neither).
AXOR_LAB_PG_PASSWORD=change-me

# ── where it listens ─────────────────────────────────────────────────────────
# Host port for the proxy. Plain HTTP until you mount certificates and switch
# the server block (deploy/nginx.conf says which three lines).
AXOR_LAB_HTTP_PORT=8443

# ── pricing ──────────────────────────────────────────────────────────────────
# Your plan catalog. The image ships docs/pricing/axor-plans.json as a starting
# point; tier names and prices are the product's, numeric limits are yours.
AXOR_LAB_PLANS_FILE=/app/docs/pricing/axor-plans.json

# ── human login (optional) ───────────────────────────────────────────────────
# Point at an axor-identity deployment's JWKS to accept its access tokens; the
# token's org and tier provision a workspace on the matching plan, failing
# CLOSED to free on an unknown tier. Empty = static tokens only.
AXOR_LAB_IDENTITY_JWKS_URL=
AXOR_LAB_IDENTITY_ISSUER=axor-identity

# ── billing (optional) ───────────────────────────────────────────────────────
# Shared secret for the payment provider's callback to /billing/webhook. Empty
# = the webhook is off. Note that checkout itself is NOT wired to a provider
# yet: /billing/checkout returns a placeholder URL, so today a plan is granted
# by an admin rather than bought. See the maturity table in README.md.
AXOR_LAB_BILLING_WEBHOOK_SECRET=

# ── anonymous trials (optional, and off by default) ──────────────────────────
# 1 enables POST /guest-session: an ephemeral in-memory workspace on the trial
# plan, 30 minutes, no registration. It is the only route an unauthenticated
# stranger can spend resources on, so turn it on only behind the rate limit in
# deploy/nginx.conf, and watch it.
AXOR_LAB_GUEST_SESSIONS=
